# Travel Compositor (Momira's account — shared by all agents)
TRAVELC_BASE_URL=https://api.travelcompositor.com
TRAVELC_MICROSITE_ID=your_microsite_id
TRAVELC_USERNAME=your_username
TRAVELC_PASSWORD=your_password

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_64_char_hex_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Cloudflare R2 (for agent logo storage)
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET=social-kit-logos
R2_PUBLIC_URL=https://pub-your-r2-bucket.r2.dev

# App
DATABASE_URL=sqlite+aiosqlite:///./agents.db
PORT=8000
