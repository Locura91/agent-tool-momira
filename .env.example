# Travel Compositor credentials
TRAVELC_BASE_URL=https://online.travelcompositor.com/resources
TRAVELC_MICROSITE_ID=your_microsite_id
TRAVELC_USERNAME=your_tc_username
TRAVELC_PASSWORD=your_tc_password

# JWT signing key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_64_char_hex_string

# Cloudflare R2 (optional for local dev — logo uploads won't work without it)
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=social-kit-logos
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

# Database (SQLite default, swap for Postgres in production)
DATABASE_URL=sqlite+aiosqlite:///./agents.db

# Server port
PORT=8000
